{
  "name": "restitch-yeongkeukeu",
  "compatibility_date": "2025-01-01",
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/admin/*",
      "/images/products/*"
    ]
  },
  "vars": {
    "GITHUB_OWNER": "progen-ai-kr",
    "GITHUB_REPO": "restitch-yeongkeukeu",
    "GITHUB_REPOS": "restitch-yeongkeukeu",
    "GITHUB_BRANCH": "main",
    "ADMIN_ENABLED": "false",
    "ADMIN_URL": "https://restitch-admin.progen-web.workers.dev/admin"
  }
}
